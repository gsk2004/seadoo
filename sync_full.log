(cl:outdiscourse point line in)

(cl:comment 'Specify the reflexive and symmetric incidence relation on points and lines')

(forall (x y)
	(if	(in x y)
		(in y x)))

(forall (x)
	(if	(or	(point x)
			(line x))
		(in x x)))

(forall (p)
	(if	(point p)
		(not (line p))))

