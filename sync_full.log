					(mol x b1)(mol a1 b1)
					(mol x b2)(mol a2 b2)
					(mol x b3)(mol a3 b3))))))

(cl-comment 'Axiom: MD-3')
(cl-comment 'Definition for chain. A chain is a group that contains an end.')
(forall (x)
	(iff (chain x)
		(and (group x)
			(exists (y)
				(and (end y x)(mol y x))))))

(cl-comment 'Axiom: MD-4')
(cl-comment 'Definition for ring. A ring is a group that contains atoms that are not ends.')
(forall (x)
	(iff (ring x)
		(and (group x)
			(not (exists (y)
