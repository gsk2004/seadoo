(cl-text http://colore.oor.net/multidim_mereotopology_codi/codi_updown.clif

(cl-comment 'CODI with downwards and upwards closure')

(cl-comment 'U-A1: everything is contained in a universal entity')

(forall (x)
	(if 
		(not (ZEX x))
		(Cont x CUni)
	)
)



