	(if
		(altitude OBJ1 OBJ2 HEIGHT)
		(orientation OBJ1 OBJ2 Above))

	(if
		(altitude OBJ1 OBJ2 HEIGHT)
		(exists
			(TOP)
			(and
				(top TOP OBJ1)
				(distance TOP OBJ2 HEIGHT))))

	(subrelation depth distance)
