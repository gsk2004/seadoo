	(if
		(and
			(attribute OBJ Monochromatic)
			(superficialPart PART OBJ)
			(attribute PART COLOR)
			(instance COLOR PrimaryColor))
		(forall
			(ELEMENT)
			(if
				(superficialPart ELEMENT OBJ)
				(attribute ELEMENT COLOR))))

