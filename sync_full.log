		(and
			(instance PERCEPTION Perception)
			(patient PERCEPTION OBJ))
		(exists
			(PROP)
			(and
				(instance PROP PerceptualAttribute)
				(holdsDuring (WhenFn PERCEPTION) (attribute OBJ PROP)))))

