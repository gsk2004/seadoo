		(exists (v z)
			(and (Part z y)(P v x)(P v (sp z))))))

(cl-comment 'Axiom ID: A5')
(forall (x y)
	(if (Part x y)
		(P (sp x) (sp y))))

(cl-comment 'Axiom ID: D2')
