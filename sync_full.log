(cl-comment 'D2: Proper Parthood')

(forall (x y)
	(iff
	 	(pp x y)
		(and
			(p x y)
			(not (= x y))
		)
	)
)

(cl-comment 'Lemma: transitivity of parthood')

(forall (x y z)
	(if
		(and
			(pp x y)
			(pp y z)
		)
		(pp x z)
	)
)


(cl-comment 'D11: Weak contact')

(forall (x y)
	(iff	(wcont x y)
		(and 	(not (c (cl x) (cl y)))
			(forall (z)
				(if 	(and	(p x z)
						(op z) )
					(c (cl z) y)
)	)	)	)	)



(cl-comment 'A13: Existence of a smallest open neighborhood n(x) for every x')

(forall (x)
	(exists (y)
		(and 	
			(p x y)
			(op y)
			(forall (z)
				(if
					(and 	
						(p x z)
						(op z))
					(p y z))))))



