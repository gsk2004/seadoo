				(superficialPart PART1 OBJ)
				(superficialPart PART2 OBJ)
				(attribute PART1 COLOR1)
				(attribute PART2 COLOR2)
				(instance COLOR1 ColorAttribute)
				(instance COLOR2 ColorAttribute)
				(not
					(=
