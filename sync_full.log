	(documentation larger EnglishLanguage '(larger OBJ1 OBJ2) means that OBJ1 is larger, with respect to all LengthMeasures, than OBJ2.')

	(iff
		(larger OBJ1 OBJ2) 
		(forall
			(QUANT1 QUANT2 UNIT)
			(if
				(and
					(measure OBJ1 (MeasureFn QUANT1 UNIT))
					(measure OBJ2 (MeasureFn QUANT2 UNIT))
