				(if (and (chain g)(inSkeleton g x))
					(exists (y z)
						(and (ring y)(ring z)
							(inSkeleton y x)(inSkeleton z x)
							(attached y g)
							(attached z g))))))))
							
(cl-comment 'Linear Skeleton Definition')
(forall (x)
